# -----------------------------------------------------------------------------
# Copie para ".env" (que NÃO vai para o Git) e ajuste se necessário.
# Sem .env, o docker-compose usa exatamente estes valores de desenvolvimento.
# Use apenas letras e números nas senhas (elas entram em URLs de conexão).
# -----------------------------------------------------------------------------

# RabbitMQ (broker local)
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app_dev

# Bancos (um por serviço)
USER_DB_USER=ms_user
USER_DB_PASSWORD=ms_user_dev
EMAIL_DB_USER=ms_email
EMAIL_DB_PASSWORD=ms_email_dev

# Remetente dos e-mails
MAIL_FROM=no-reply@cadastro.local

# Detalhes no /health: "always" em desenvolvimento, "when-authorized" em produção
HEALTH_SHOW_DETAILS=always

# Réplicas de cada serviço (o api-gateway distribui entre elas; ADR-0005).
# Também dá para mudar na hora: docker compose up -d --scale ms-user=4
MS_USER_REPLICAS=2
MS_EMAIL_REPLICAS=2

# Conexões no pool de cada réplica (5 réplicas x 10 = 50, abaixo do limite de 100 do Postgres)
DB_POOL_MAX_SIZE=10

# Portas no host (mude se já estiverem em uso na sua máquina).
# Só o api-gateway publica porta HTTP de aplicação; os serviços não têm porta no host.
GATEWAY_PORT=8080
DISCOVERY_UI_PORT=8761
USER_DB_PORT=5433
EMAIL_DB_PORT=5434
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Teste de carga (k6)
LOAD_RATE=50
LOAD_DURATION=2m
